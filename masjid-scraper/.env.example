# Database Configuration
# PostgreSQL async connection URL for SQLAlchemy (uses asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/masjid_db

# PostgreSQL sync connection URL for migrations and tools (uses psycopg2 driver)
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/masjid_db

# Application Configuration
# Enable debug mode for development (shows detailed errors and logs)
DEBUG=False

# Scraping Configuration
# How often to run the automatic scraping job (in hours)
SCRAPE_INTERVAL_HOURS=6

# Delay between HTTP requests to avoid overwhelming the server (in seconds)
REQUEST_DELAY_SECONDS=1.5

# Base URL for the MasjidBoardLive website
BASE_URL=https://masjidboardlive.com
